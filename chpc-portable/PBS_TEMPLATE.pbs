#!/bin/bash
#PBS -P CHANGE_ME_PROJECT_CODE
#PBS -q gpu_1
#PBS -N CHANGE_ME_job_name
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -o CHANGE_ME_REMOTE_PROJECT/logs/CHANGE_ME_job_name_${PBS_JOBID}.out
#PBS -e CHANGE_ME_REMOTE_PROJECT/logs/CHANGE_ME_job_name_${PBS_JOBID}.err

set -euo pipefail

PROJECT_DIR="CHANGE_ME_REMOTE_PROJECT"
cd "$PROJECT_DIR"
mkdir -p logs

# Use the existing shared SNN environment unchanged, or replace with .venv/bin/activate.
source /mnt/lustre/users/jenslin/SNN/.snn-venv3/bin/activate

# Make an in-project src/ package importable when applicable.
export PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"

echo "Host: $(hostname)"
echo "Started: $(date --iso-8601=seconds)"
which python
python --version
nvidia-smi

# Replace this with the project's actual training command.
# Keep credentials out of this file. For W&B experiments, prefer an existing
# private environment file or set WANDB_MODE=offline.
python train.py --config configs/experiment.yaml

echo "Finished: $(date --iso-8601=seconds)"
